{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.huseyinemrecevik.com"
        }
      ],
      "destination": "https://huseyinemrecevik.com/$1",
      "permanent": true
    }
  ]
}
